# Copy to .env and fill in. NEVER commit the real .env.
# On Plesk, set these as the Node.js app's environment variables instead.

# --- Server ---
PORT=3000

# --- Panel (EMA) connection ---
# Host and port of the alarm panel / transmission unit, as reachable from THIS backend.
# A cloud backend must use the externally reachable address (e.g. a MyFRITZ address),
# not a LAN IP like 192.168.x.x.
EMA_HOST=example.myfritz.net
EMA_PORT=8016

# Benutzergruppe ("group") configured for the panel interface (often just a number).
EMA_GROUP=1

# --- Encryption (optional) ---
# Leave EMPTY if the panel has no key configured -> commands are sent in plaintext.
# Set to the 32 hex-char key (AES-128) if the panel has a key -> AES/ECB/PKCS7 is used.
EMA_AES_KEY=

# --- App login (browser -> backend) ---
# The PWA authenticates against the backend with these before it can reach the panel.
APP_LOGIN_EMAIL=you@example.com
# Store a hash in production; plaintext here only for first local testing.
APP_LOGIN_PASSWORD=change-me
# Secret used to sign session tokens.
SESSION_SECRET=change-me-to-a-long-random-string
